# Slay the Spire 2 Workout Mode Helper - Environment Configuration

# Daemon Server Settings
PORT=8765
HOST=0.0.0.0
# Remote Daemon Host IP: Set to host's LAN/Public IP if overlay is running on a secondary guest PC
DAEMON_HOST=127.0.0.1
LOG_LEVEL=info

# Save File Path Override
# Optional: Set custom directory path to monitor for Slay the Spire 2 save files.
# If left blank, defaults to %APPDATA%\SlayTheSpire2\steam<SteamID>\profile1\saves\
STS2_SAVE_DIR=C:\Users\JohnDoe\AppData\Roaming\SlayTheSpire2\steam\<yoursteamid>\profile1\saves

# Security & API Secrets
# Local session authentication token (if enabled)
SESSION_SECRET=local-workout-secret-change-me

# Player Name Mapping
PLAYER_NAME_0=Peter
PLAYER_NAME_1=Matthew

# Electron Overlay Settings
ELECTRON_ALWAYS_ON_TOP=true
ELECTRON_CLICK_THROUGH_DEFAULT=false
